PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://taskflow:taskflow_secret_pass@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=taskflow_super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=taskflow_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Transactional Email Provider (Choose Resend or Postmark)
# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Postmark: https://account.postmarkapp.com/servers
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=TaskFlow Pro <notifications@taskflow.dev>

# Stripe Billing & Subscriptions (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=price_pro_monthly
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# File Attachments & Cloud Storage (local, s3, or cloudinary)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
CLOUDINARY_URL=
