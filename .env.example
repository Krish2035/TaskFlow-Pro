# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://taskflow:taskflow_secret_pass@localhost:5432/taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_secret_pass
POSTGRES_DB=taskflow

# Cache and Coordination (Redis)
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_ACCESS_SECRET=taskflow_super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=taskflow_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security and CORS
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Transactional Email Provider (Resend or Postmark)
# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Postmark: https://account.postmarkapp.com/servers
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=TaskFlow Pro <notifications@taskflow.dev>

# Client Configuration (Frontend)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
